<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nmp.habittrackeranmp.view.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.nmp.habittrackeranmp.view.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_newHabitFragment"
            app:destination="@id/newHabitFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_editHabitFragment"
            app:destination="@id/editHabitFragment" />

    </fragment>

    <fragment
        android:id="@+id/newHabitFragment"
        android:name="com.nmp.habittrackeranmp.view.NewHabitFragment"
        android:label="New Habit"
        tools:layout="@layout/fragment_new_habit" />

    <fragment
        android:id="@+id/editHabitFragment"
        android:name="com.nmp.habittrackeranmp.view.EditHabitFragment"
        android:label="Edit Habit"
        tools:layout="@layout/fragment_edit_habit">

        <argument
            android:name="habitId"
            app:argType="integer" />

    </fragment>

</navigation>