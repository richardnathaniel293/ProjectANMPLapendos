<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.nmp.habittrackeranmp.viewmodel.EditHabitViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_background"
        tools:context=".view.EditHabitFragment">

        <LinearLayout
            android:id="@+id/layoutToolbar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/control_plus_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/back_arrow"
                android:textColor="@android:color/white"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/txtToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Update Habit"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollEditHabit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEditHabit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/txtEditHabitHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Habit Data"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/txtHabitName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="@string/habit_name_required"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@={viewModel.name}"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/txtHabitDescription"
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:layout_marginTop="14dp"
                            android:background="@android:drawable/edit_text"
                            android:gravity="top"
                            android:hint="@string/habit_description_required"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:padding="12dp"
                            android:text="@={viewModel.description}"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/txtGoal"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="@string/habit_goal_required"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@={viewModel.goal}"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtGoalHelper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/goal_helper"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/txtUnit"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="@string/unit_required"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@={viewModel.unit}"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtUnitHelper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/unit_helper"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtChooseIcon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/select_icon"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spIcon"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:drawable/edit_text"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/update_habit"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/control_plus_background"
                    app:cornerRadius="6dp" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>